# ==============================================================================
# Enterprise AI Phishing Detection & SOC Platform - Production .gitignore
# ==============================================================================

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Environment Variables & Configuration Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Machine Learning Models & Trained Weights (Track via DVC or S3/GCS buckets)
*.pkl
*.pickle
*.joblib
*.h5
*.hdf5
*.pt
*.pth
*.onnx
*.weights
*.bin
backend/models/*.pkl
backend/models/*.joblib

# Node.js & Frontend
node_modules/
jspm_packages/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
frontend/dist/
frontend/build/
.pnp
.pnp.js

# Credentials, API Keys & Certificates
credentials.json
service_account.json
client_secret*.json
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
secrets/

# Local File Integrity Monitoring (FIM) Sandbox (Dynamic target folder)
fim_sandbox/*
!fim_sandbox/.gitkeep

# Large Data & Datasets (Preserve folder structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Databases & Local Logs
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
*.log
logs/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Directories
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo
